# ColBERT GPU Docker Image
# Optimized for A100/H100 GPUs with GPU-accelerated filtered search
#
# Build:
#   docker build -t colbert-gpu -f docker/Dockerfile.gpu .
#
# Run:
#   docker run --gpus all -it -v $(pwd)/data:/app/data colbert-gpu

# Use NVIDIA PyTorch container as base
# This includes PyTorch 2.x, CUDA 12.x, cuDNN, and optimized libraries
FROM nvcr.io/nvidia/pytorch:24.01-py3

LABEL maintainer="ColBERT Contributors"
LABEL description="ColBERT with GPU-accelerated filtered search for A100/H100"

# Set working directory
WORKDIR /app

# Prevent interactive prompts during apt-get
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    wget \
    curl \
    vim \
    htop \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Install faiss-gpu (CUDA 12 compatible)
# Using conda for faiss as it has better GPU support
RUN conda install -y -c pytorch -c nvidia faiss-gpu=1.7.4 \
    && conda clean -afy

# Copy ColBERT source code
COPY . /app/

# Install ColBERT with dev dependencies
RUN pip install --no-cache-dir -e ".[dev]"

# Install additional dependencies for benchmarking and testing
RUN pip install --no-cache-dir \
    pytest>=7.0.0 \
    pytest-benchmark>=4.0.0 \
    pytest-cov>=4.0.0 \
    memory_profiler>=0.61.0 \
    line_profiler>=4.0.0

# Download ColBERTv2 checkpoint (optional - uncomment if needed)
# RUN mkdir -p /app/checkpoints && \
#     wget -q https://downloads.cs.stanford.edu/nlp/data/colbert/colbertv2/colbertv2.0.tar.gz -O /tmp/colbertv2.tar.gz && \
#     tar -xzf /tmp/colbertv2.tar.gz -C /app/checkpoints && \
#     rm /tmp/colbertv2.tar.gz

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV CUDA_VISIBLE_DEVICES=0
ENV TOKENIZERS_PARALLELISM=false

# Create directories for data and experiments
RUN mkdir -p /app/data /app/experiments /app/indexes

# Health check - verify GPU access
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD python -c "import torch; assert torch.cuda.is_available()" || exit 1

# Default command: run a quick GPU check then drop to bash
CMD ["bash", "-c", "python -c \"import torch; print(f'PyTorch {torch.__version__}, CUDA {torch.version.cuda}, GPU: {torch.cuda.get_device_name(0) if torch.cuda.is_available() else \"None\"}')\" && exec bash"]
