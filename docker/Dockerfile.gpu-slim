# ColBERT GPU Docker Image (Slim)
# Lighter weight image using official CUDA base
# Use this if you need more control over versions or smaller image size
#
# Build:
#   docker build -t colbert-gpu-slim -f docker/Dockerfile.gpu-slim .
#
# Run:
#   docker run --gpus all -it -v $(pwd)/data:/app/data colbert-gpu-slim

FROM nvidia/cuda:12.2.2-cudnn8-runtime-ubuntu22.04

LABEL maintainer="ColBERT Contributors"
LABEL description="ColBERT GPU (slim) for A100/H100"

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install Python and minimal system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.10 \
    python3-pip \
    python3.10-dev \
    python3.10-venv \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.10 /usr/bin/python \
    && ln -sf /usr/bin/pip3 /usr/bin/pip

# Upgrade pip
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Install PyTorch with CUDA 12.1 support
RUN pip install --no-cache-dir \
    torch==2.1.2 \
    torchvision==0.16.2 \
    torchaudio==2.1.2 \
    --index-url https://download.pytorch.org/whl/cu121

# Install faiss-gpu
RUN pip install --no-cache-dir faiss-gpu

WORKDIR /app

# Copy and install ColBERT
COPY . /app/
RUN pip install --no-cache-dir -e ".[dev]"

# Install test dependencies
RUN pip install --no-cache-dir pytest pytest-benchmark

# Environment
ENV PYTHONUNBUFFERED=1
ENV CUDA_VISIBLE_DEVICES=0
ENV TOKENIZERS_PARALLELISM=false

RUN mkdir -p /app/data /app/experiments

CMD ["bash"]
